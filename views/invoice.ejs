<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skapa faktura</title>
    <link rel="stylesheet" href="css/invoice.css">
</head>
<body>
<div class="container">

    <h1>Skapa faktura</h1>

    <form action="/create-invoice" method="POST">

        <h2>Fakturainformation</h2>

        <div class="grid">

            <div class="field">
                <label>Typ</label>

                <select name="type">
                    <option value="faktura" selected>Faktura</option>
                    <option value="kvitto">Kvitto</option>
                </select>
            </div>

            <div class="field">
                <label>Nummer</label>

                <input
                    type="text"
                    name="number"
                    placeholder="2026-001"
                    required
                >
            </div>

            <div class="field">
                <label>Datum</label>

                <input
                    type="date"
                    name="date"
                    id="date"
                    required
                >
            </div>

            <div class="field">
                <label>Förfallodatum</label>

                <input
                    type="date"
                    name="dueDate"
                    id="dueDate"
                    required
                >
            </div>

        </div>


        <h2>Företag</h2>

        <details>
        <summary>Företagsinställningar</summary>
        <div class="grid">

            <div class="field full">
                <label>Bolag</label>

                <input
                    type="text"
                    name="company_name"
                    value="Emil Söderqvist"
                    required
                >
            </div>

            <div class="field">
                <label>Org.nr / Person.nr</label>

                <input
                    type="text"
                    name="company_orgNumber"
                    value="20071103-6194"
                >
            </div>

            <div class="field">
                <label>Momsregistreringsnummer</label>

                <input
                    type="text"
                    name="company_vatNumber"
                    value="SE559123456701"
                >
            </div>

            <div class="field full">
                <label>Gatuadress</label>

                <input
                    type="text"
                    name="company_address"
                    value="Södergatan 3F"
                >
            </div>

            <div class="field">
                <label>Stad</label>

                <input
                    type="text"
                    name="company_city"
                    value="Staffanstorp"
                >
            </div>

            <div class="field">
                <label>Postkod</label>

                <input
                    type="text"
                    name="company_postalCode"
                    value="245 31"
                >
            </div>

            <div class="field">
                <label>Telefon</label>

                <input
                    type="text"
                    name="company_phone"
                    value="070-385 42 36"
                >
            </div>

            <div class="field">
                <label>E-post</label>

                <input
                    type="email"
                    name="company_email"
                    value="kontakt@emilsoderqvist.com"
                >
            </div>

            <div class="field full">
                <label>Hemsida</label>

                <input
                    type="text"
                    name="company_website"
                    value="https://emilsoderqvist.com"
                >
            </div>

        </div>
        </details>


        <h2>Kund</h2>

        <div class="grid">

            <div class="field full">
                <label>Kundnamn</label>

                <input
                    type="text"
                    name="customer_name"
                    required
                >
            </div>

            <div class="field">
                <label>Kund-ID</label>

                <input
                    type="text"
                    name="customer_id"
                    placeholder="K-001"
                >
            </div>

            <div class="field">
                <label>Telefonnummer</label>

                <input
                    type="text"
                    name="customer_phone"
                >
            </div>

            <div class="field">
                <label for="customer_personNumber">Personnummer</label>
                <input
                    type="text"
                    id="customer_personNumber"
                    name="customer_personNumber"
                    placeholder="YYYYMMDD-XXXX"
                >
            </div>

            <div class="field full">
                <label>Gatuadress</label>

                <input
                    type="text"
                    name="customer_address"
                >
            </div>

            <div class="field">
                <label>Stad</label>

                <input
                    type="text"
                    name="customer_city"
                    placeholder="Staffanstorp"
                    value="Staffanstorp"
                >
            </div>

            <div class="field">
                <label>Postkod</label>

                <input
                    type="text"
                    name="customer_postalCode"
                >
            </div>

            <div class="field full">
                <label>Kommentar</label>
                <input
                    type="text"
                    name="comment"
                    value="Tack för er tid och ert förtroende. Välkommen åter. Lämna gärna en recension för Emils Teknikhjälp på Google eller Facebook!"
                >
            </div>

        </div>


        <h2>Artiklar</h2>

        <div id="articles">

            <div class="article">

                <div class="field">
                    <label>Antal</label>

                    <input
                        type="number"
                        name="quantity[]"
                        value="1"
                        min="0"
                        step="1"
                        required
                    >
                </div>

                <div class="field">
                    <label>Artikelnamn</label>

                    <input
                        type="text"
                        name="article_name[]"
                        value="Konsult i hemmet"
                        required
                    >
                </div>

                <div class="field">
                    <label>Pris exkl. moms</label>

                    <input
                        type="number"
                        name="priceExclVat[]"
                        value="600"
                        min="0"
                        step="1"
                        required
                    >
                </div>

                <div class="field">
                    <label>Moms %</label>

                    <input
                        type="number"
                        name="vatRate[]"
                        value="25"
                        min="0"
                        step="1"
                        required
                    >
                </div>

                <div class="field">
                    <label>RUT %</label>
                    <input
                        type="number"
                        name="rutRate[]"
                        value="50"
                        min="0"
                        max="100"
                        step="1"
                        required
                    >
                </div>

                <button
                    type="button"
                    class="remove"
                    onclick="removeArticle(this)"
                >
                    ×
                </button>

            </div>


            <div class="article">

                <div class="field">
                    <label>Antal</label>

                    <input
                        type="number"
                        name="quantity[]"
                        value="1"
                        min="0"
                        step="1"
                        required
                    >
                </div>

                <div class="field">
                    <label>Artikelnamn</label>

                    <input
                        type="text"
                        name="article_name[]"
                        value="Utkörningsavgift Staffanstorp"
                        required
                    >
                </div>

                <div class="field">
                    <label>Pris exkl. moms</label>

                    <input
                        type="number"
                        name="priceExclVat[]"
                        value="16"
                        min="0"
                        step="1"
                        required
                    >
                </div>

                <div class="field">
                    <label>Moms %</label>

                    <input
                        type="number"
                        name="vatRate[]"
                        value="25"
                        min="0"
                        step="1"
                        required
                    >
                </div>

                <div class="field">
                    <label>RUT %</label>
                    <input
                        type="number"
                        name="rutRate[]"
                        value="0"
                        min="0"
                        max="100"
                        step="1"
                        required
                    >
                </div>

                <button
                    type="button"
                    class="remove"
                    onclick="removeArticle(this)"
                >
                    ×
                </button>

            </div>

        </div>


        <button
            type="button"
            class="add"
            onclick="addArticle()"
        >
            + Lägg till artikel
        </button>


        <button
            type="submit"
            class="submit"
        >
            Skapa PDF
        </button>

    </form>

</div>


<script>

    /*
     * Format a Date as YYYY-MM-DD
     */
    function formatDate(date) {

        const year = date.getFullYear();

        const month = String(
            date.getMonth() + 1
        ).padStart(2, "0");

        const day = String(
            date.getDate()
        ).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }


    /*
     * Set today's date and due date one month ahead
     */
    function setDefaultDates() {

        const today = new Date();

        const dueDate = new Date(today);

        dueDate.setMonth(
            dueDate.getMonth() + 1
        );

        document.getElementById("date").value =
            formatDate(today);

        document.getElementById("dueDate").value =
            formatDate(dueDate);
    }


    /*
     * Add a new article
     */
    function addArticle() {

        const container =
            document.getElementById("articles");

        const article =
            document.createElement("div");

        article.className = "article";

        article.innerHTML = `
            <div class="field">
                <label>Antal</label>

                <input
                    type="number"
                    name="quantity[]"
                    value="1"
                    min="0"
                    step="1"
                    required
                >
            </div>

            <div class="field">
                <label>Artikelnamn</label>

                <input
                    type="text"
                    name="article_name[]"
                    required
                >
            </div>

            <div class="field">
                <label>Pris exkl. moms</label>

                <input
                    type="number"
                    name="priceExclVat[]"
                    min="0"
                    step="1"
                    required
                >
            </div>

            <div class="field">
                <label>Moms %</label>

                <input
                    type="number"
                    name="vatRate[]"
                    value="25"
                    min="0"
                    step="1"
                    required
                >
            </div>

            <div class="field">
                <label>RUT %</label>
                <input
                    type="number"
                    name="rutRate[]"
                    value="0"
                    min="0"
                    max="100"
                    step="1"
                    required
                >
            </div>

            <button
                type="button"
                class="remove"
                onclick="removeArticle(this)"
            >
                ×
            </button>
        `;

        container.appendChild(article);
    }


    /*
     * Remove an article
     */
    function removeArticle(button) {

        const articles =
            document.querySelectorAll(".article");

        if (articles.length <= 1) {
            return;
        }

        button.parentElement.remove();
    }


    /*
     * Set dates when page loads
     */
    setDefaultDates();

</script>

</body>
</html>